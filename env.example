DATABASE_URL=${{ Postgres.DATABASE_URL }}
SECRET_KEY=gere-uma-sequencia-longa-e-aleatoria
ADMIN_USER=marcelo
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_NOME=Marcelo
COLETA_TOKEN=opcional
# Meu Parlamentar · IA (questões de ordem, radar, Seleção da IA, áreas): Gemini, plano gratuito
# crie a chave em aistudio.google.com (Get API key), num projeto SEM faturamento para continuar gratuito
GEMINI_API_KEY=
# opcionais: modelos (padrões gemini-3.8-flash e gemini-3.5-flash-lite) e segundos entre chamadas (padrão 6)
GEMINI_MODEL=
GEMINI_MODEL_RAPIDO=
GEMINI_INTERVALO=
# opcional: dias de pautas lidos na primeira vez para montar as relatorias (padrão 180)
MEU_DIAS_HISTORICO=
# opcional: radar de notícias (padrões: a cada 2 horas, gemini-3.5-flash-lite, 30 análises por deputado e ciclo)
RADAR_HORAS=
RADAR_MODEL=
RADAR_MAX_ANALISES=
# Aba Plenário: banco do app Minha Pauta (somente leitura)
MINHA_PAUTA_DATABASE_URL=
# opcional: aviso de solicitações no app Minha Pauta (o mesmo valor vai em PAINEL_TOKEN lá)
TAREFAS_TOKEN=
